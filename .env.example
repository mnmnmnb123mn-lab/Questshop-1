# Questshop first-run input
# Fill these values, save as .env, then run: npm run setup

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=

# SQLite — this directory must be persistent in production.
SQLITE_PATH=/data/questshop.db
# Generate once, keep private, and do not change after the first deployment.
QUESTSHOP_SECRET_KEY=
# Increment only with a coordinated proof-key migration; voucher identity stays stable across versions.
VOUCHER_HMAC_ACTIVE_VERSION=v1
CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=v1
CREDENTIAL_ENCRYPTION_ALLOWED_VERSIONS=v1

# Runtime identity and authenticated health endpoint. GIT_SHA is required in production.
STATUS_TOKEN=
GIT_SHA=
PRELAUNCH=true
RUNNER_CONCURRENCY=1
RUNNER_CONCURRENCY_HARD_MAX=1
