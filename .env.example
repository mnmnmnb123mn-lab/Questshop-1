# Questshop first-run input
# Fill only these values, save as .env, then run: npm run setup

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=

# PostgreSQL
# Example: postgresql://questshop_runtime:password@host:5432/questshop?sslmode=verify-full
DATABASE_POOL_URL=
# Example: postgresql://questshop_migrator:password@host:5432/questshop?sslmode=verify-full
DATABASE_DIRECT_URL=

# Optional private CA. Use an absolute PEM path or Base64; omit it when the
# managed PostgreSQL certificate already chains to Node's trusted root store.
# npm run setup converts it to DATABASE_SSL_CA_BASE64 automatically.
DATABASE_SSL_CA_INPUT=
