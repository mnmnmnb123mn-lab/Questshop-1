# Questshop first-run input
# Fill only these values, save as .env, then run: npm run setup

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=

# SQLite — this directory must be persistent in production.
SQLITE_PATH=/data/questshop.db
# Generate once, keep private, and do not change after the first deployment.
QUESTSHOP_SECRET_KEY=
