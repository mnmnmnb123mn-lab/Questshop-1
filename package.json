{
  "name": "questshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "setup:init": "node scripts/setup.js",
    "setup:verify": "node scripts/setup-verify.js",
    "setup:preflight": "node scripts/setup-preflight.js",
    "setup:export-secret-bundle": "node scripts/export-secret-bundle.js",
    "keys:adopt": "node scripts/adopt-keyring-sentinels.js",
    "keys:retire:verify": "node scripts/verify-key-retirement.js",
    "db:verify-roles": "node scripts/verify-postgres-roles.js",
    "deploy": "npm run setup:verify && npm run migrate && npm run register",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node scripts/register-commands.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "backup:reconcile": "node scripts/reconcile-backups.js",
    "restore:drill": "node scripts/restore-drill.js",
    "prelaunch:closeout": "node scripts/prelaunch-closeout.js",
    "load:test": "node scripts/load-test.js",
    "check": "find src scripts test -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "lint": "eslint src scripts test",
    "test": "node scripts/test-files.js",
    "test:coverage": "node scripts/test-files.js --coverage && node scripts/check-coverage.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node scripts/test-files.js test/integration test/concurrency test/crash",
    "verify": "npm run check && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/lib-storage": "3.1101.0",
    "discord.js": "14.27.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "fast-check": "4.9.0"
  }
}
